
function LocalSymbol(a, p, K)
    K_p, phi := Completion(K, p);
    OK := RingOfIntegers(K);
    if IsSquare(phi( K !a)) then
        return 1;
    else
        return -1;
    end if;
end function;

function JacobiSymbol(a, b, K)
    OK := RingOfIntegers(K);
    I := ideal<OK | b>;
    F := Factorization(I);
    result := 1;
    for f in F do
        result := result * LocalSymbol(a, f[1], K);
    end for;
    return result;
end function;

r :=2; //This is where you can change r
F2 := GF(2);
V := VectorSpace(F2, 2*r);
W := VectorSpace(F2, r);
pi1 := hom<V -> W | x :-> Vector(F2, [x[i] : i in [1..r]])>;
pi2 := hom<V -> W | x :-> Vector(F2, [x[i] : i in [r+1..2*r]])>;

dot := func<u, v | InnerProduct(u,v)>;

function RandomFactorisation(d, OK, V) //Produces a 'random' factorisation of D enumeratedd by V
    A := AssociativeArray();
    for v in V do
        A[v] := OK ! 1;
    end for;
    F := Factorization(ideal<OK | d>);
    for f in F do
        p := f[1]; e := f[2];
        tf, gen := IsPrincipal(p);
        v := Random(V);
        A[v] := A[v] * gen^e;
    end for;
    return A;
end function;

f := func<x | x eq F2!1 select 1 else 0>;

function BigProduct(a, A, V, OK) //Calculayes RHS of 3.10, a=-alpha0/D, A is our factorisation, V f2^r
    result := 1;
    for u in V do
        e1 := f(dot(pi1(u), pi2(u)));
            result := result * JacobiSymbol(a, A[u], OK)^(e1);
        for v in V do
            if v ne u then
                
                e2 := f(dot(pi1(u), pi2(v)));
                e3 := f(dot(pi1(v),pi2(v)));
                result := result * JacobiSymbol(A[u], A[v], OK)^(e2+e3);
            end if;
        end for;
    end for;
    return result;
end function;

function ComputeU(A, V, OK, r) //GIVES US U FROM FACTORISATION
    u := [];
    for i in [1..r] do
        prod := OK ! 1;
        for v in V do
            prod := prod * A[v]^(Integers()!v[i]);
        end for;
        Append(~u, prod);
    end for;
    return u;
end function;

function ComputeZ(A, V, P, OK, r, alpha) //Gives us z from factorisation
    Z := AssociativeArray();
    for p in P do
        // find the unique v in V such that p divides A[v]
        for v in V do
            if ideal<OK | A[v]> subset p then  // p divides A[v]
                z_p := [];
                for i in [1..r] do
                    Append(~z_p, alpha^(Integers()!v[i+r]));
                end for;
                Z[p] := z_p;
                break;
            end if;
        end for;
    end for;
    return Z;
end function;

function PairingUZ(u, Z, P, OK, r)
    result := 1;
    K := NumberField(OK);
    for p in P do
        K_p, phi := Completion(K, p);
        for i in [1..r] do
            a := (K ! u[i]);
            b := (K ! Z[p][i]);
            result := result * HilbertSymbol(a, b, p);
        end for;
    end for;
    return result;
end function;

R<x> := PolynomialRing(Integers());
f := x^2-2;
K := NumberField(f);
alpha := 653 + 435*K.1; 
alphaideal := ideal<OK|alpha>;
Factalphaexlud2 := [f[1] : f in Factorization(alphaideal) | Norm(f[1]) mod 2 ne 0];
D := &* Factalphaexlud2;
alpha_0 := alpha*(D)^(-1);
negalpha0 := (-1)*alpha_0;
_, negalpha0 := IsPrincipal(negalpha0);

FixedFact := RandomFactorisation(D,OK,V);

BigProduct(negalpha0, FixedFact, V, OK);
z := ComputeZ(FixedFact, V, Factalphaexlud2, OK, r, alpha);
u := ComputeU(FixedFact, V, OK, r);
PairingUZ(u,z, Factalphaexlud2, OK,r);

