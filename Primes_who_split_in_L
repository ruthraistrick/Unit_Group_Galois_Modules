R<x> := PolynomialRing(Integers());
f := x^2 -2;
K := NumberField(f);
OK := RingOfIntegers(K);
Ugp, Umap := UnitGroup(OK);
a := Umap(Ugp.2);
if Norm(a) lt 0 then
    a := (-1)*a;
end if; 
T<y> := PolynomialRing(K);
L := NumberField(y^2-a);
OL := RingOfIntegers(L);

bound := 200;
split_primes := [];

primes_K := PrimesUpTo(bound, K);  

for p in primes_K do
    factors := Decomposition(OL,p);
    if #factors eq 2 then
        Append(~split_primes, p);
    end if;
end for;

split_primes_gen := [];

for p in split_primes do
    Bool, gen := IsPrincipal(p);
    Append(~split_primes_gen, gen);
end for; 
