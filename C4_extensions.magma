function RepAsMatrixCyclic(K,F) //turns the action of the generator into a matrix 
//K is the no field, F is the ring you want the matrix to be defined over
    n := Degree(K);
    OK := RingOfIntegers(K);
    r1,r2 := Signature(K);
    rank := r1 + r2 -1;
    Ugp, Umap := UnitGroup(OK);
    n := #Generators(Ugp);
    u := n - rank;
    G, Aut, phi  := AutomorphismGroup(K);
    gens := [];
    for i in [u+1 ..n] do
        Append(~gens, K ! Umap(Ugp.i));
    end for; //generators of free part of unit group
    Auts:= Automorphisms(K);
    for phi in Auts do //gives us gen, an automorphism generating the galois group
        a := K.1;
        x := phi(a);
        ord := 1;
        while x ne a do
            x := phi(x);
            ord +:= 1;
        end while;
        if ord eq n then
            gen := phi;
            break;
        end if;
    end for;
    function Vector(g)
        action := (OK ! (gen(g))) @@ Umap;
        coords := ElementToSequence(action);
        correctcoords:= coords[2..4];
        return correctcoords;
    end function;
    M := Transpose(Matrix(F, 3, 3, &cat[Vector(g) : g in gens]));
    return M;
end function;
function C4UnitStructure(K)
    F := Rationals();
    G := GaloisGroup(K);
    C4 := CyclicGroup(4);
    if IsIsomorphic(G,C4) then
        r1, r2 := Signature(K);
        OK := RingOfIntegers(K);
        Ugp, Umap := UnitGroup(OK);
        Aut := Automorphisms(K);
        if r1 eq 0 and r2 eq 2 then  //deals with the easy case - 4 complex roots
            gen1 := K ! Umap(Ugp.2);
            if Aut[2](gen1) eq -1*gen1 or Aut[2](gen1) eq gen1 then
                return Matrix(Rationals(),1,1,[1]);
            else 
                return Matrix(Rationals(),1,1,[-1]);
            end if;
        elif r1 eq 4 and r2 eq 0 then //deals with harder case - 4 real roots
            M := RepAsMatrixCyclic(K,Rationals());
            L := FiniteField(2,1);
            M2 := ChangeRing(M,L);
            F2Matrices := [ 
                Matrix(L,3,3, [[-1,0,0], [0,0,-1], [0,1,0]]), 
                Matrix(L,3,3,[[0,-1,1],[1,0,0],[0,0,-1]])];
            IntegralMatrices := [Matrix(Integers(),3,3, [[-1,0,0], [0,0,-1], [0,1,0]]),
                Matrix(Integers(),3,3,[[0,-1,1],[1,0,0],[0,0,-1]])];
            Rep1 := GModule(CyclicGroup(4),[Matrix(Integers(),3,3, [[-1,0,0], [0,0,-1], [0,1,0]])]);
            Rep2 := GModule(CyclicGroup(4),[Matrix(Integers(),3,3,[[0,-1,1],[1,0,0],[0,0,-1]])]);
            IntegralReps :=[Rep1,Rep2];
            FiniteSimilarMatrices := [];
            for i in [1..2] do
                if IsSimilar(M2, F2Matrices[i]) eq true then
                return IntegralReps[i], IntegralMatrices[i];
                end if;
            end for;
        else
            return "Can't do";
        end if;
    else 
        return "This function is only for C4 extensions";
    end if;
end function;   
