function RepAsMatrixCyclic(K,F) //turns the action of the generator into a matrix 
//K is the no field, F is the ring you want the matrix to be defined over
    n := Degree(K);
    OK := RingOfIntegers(K);
    r1,r2 := Signature(K);
    rank := r1 + r2 -1;
    Ugp, Umap := UnitGroup(OK);
    n := #Generators(Ugp);
    u := n - rank;
    G, Aut, phi  := AutomorphismGroup(K);
    gens := [];
    for i in [u+1 ..n] do
        Append(~gens, K ! Umap(Ugp.i));
    end for; //generators of free part of unit group
    Auts:= Automorphisms(K);
    for phi in Auts do //gives us gen, an automorphism generating the galois group
        a := K.1;
        x := phi(a);
        ord := 1;
        while x ne a do
            x := phi(x);
            ord +:= 1;
        end while;
        if ord eq n then
            gen := phi;
            break;
        end if;
    end for;