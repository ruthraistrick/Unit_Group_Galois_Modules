OK := RingOfIntegers(K);
alpha := 3456+5222*K.1;K.
alphaideal := ideal<OK|alpha>;
Ugp, Umap := UnitGroup(OK);
a := (-1)*Umap(Ugp.2);
F<y> := PolynomialRing(K);
g := y^2-a;
L := NumberField(g);
OL := RingOfIntegers(L);
for p in Factorisation(alphaideal) do
    prime := p[1];
    prime;
    Decomposition(OL,prime);
end for;

